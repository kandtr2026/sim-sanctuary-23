# Copy to `.env` and fill in. `.env` is gitignored.
#
# All three are optional: src/integrations/supabase/config.ts falls back to the
# production project when they are unset, so a fresh clone runs without setup.
# Set them to point a local build at a different Supabase project.
#
# NOTE: every NEXT_PUBLIC_-prefixed variable is inlined into the client bundle at
# build time and is therefore public. Only ever put publishable values here — the
# Supabase `anon` key, never a `service_role` key. Secrets belong in Edge
# Function environment variables (see supabase/functions/).

NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Facebook Pixel (nghiệp vụ FB Ads): chủ dự án set giá trị trong Vercel env
# khi bắt đầu chạy quảng cáo Facebook. Để trống → pixel không tải, web chạy bình thường.
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Ads conversion (nghiệp vụ Google Ads, task A3): set AW-… + label Zalo
# trong Vercel env khi chủ shop cấp. Để trống → không bắn, web chạy bình thường.
NEXT_PUBLIC_GADS_AW_ID=
NEXT_PUBLIC_GADS_CONV_LABEL=
